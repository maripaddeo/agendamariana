<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mariana Di Falcco — Agenda Astral</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Cinzel:wght@400;500;600&family=Cinzel+Decorative:wght@400&display=swap" rel="stylesheet">
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#0a0818;--bg2:#14102a;--bg3:#1e1840;--card:#181430;--card2:#221e3c;
  --gold:#f0c040;--gold2:#d4a030;--gold3:#a87020;
  --text:#f0ecff;--text2:#c0b0e8;--text3:#806898;
  --border:#4a3880;--bsoft:#2e2258;
  --c-mapa:#b060ff;--c-solar:#ffb020;--c-sinastria:#ff4d94;
  --c-tarot:#ff4444;--c-cigano:#ff7820;--c-sibilla:#00d0f0;--c-geral:#00c880;
  --c-blocked:#556070;
  --m-nova:rgba(80,60,180,.22);--m-crescente:rgba(0,180,80,.16);
  --m-cheia:rgba(240,192,64,.20);--m-minguante:rgba(160,60,220,.18);
  --shadow:rgba(0,0,0,.5);--fs:22px;
}
body{font-family:'Cormorant Garamond',serif;background:var(--bg);color:var(--text);min-height:100vh;font-size:var(--fs);line-height:1.65;}
.app{max-width:1120px;margin:0 auto;padding:0 20px 80px;}

/* HERO */
.hero{text-align:center;padding:44px 0 28px;border-bottom:1px solid var(--bsoft);margin-bottom:26px;}
.hero-orn{font-size:13px;letter-spacing:6px;color:var(--gold2);font-family:'Cinzel',serif;margin-bottom:12px;}
.hero-name{font-family:'Cinzel Decorative',serif;font-size:44px;color:var(--gold);letter-spacing:3px;margin-bottom:6px;text-shadow:0 0 40px rgba(240,192,64,.3);}
.hero-title{font-family:'Cinzel',serif;font-size:13px;letter-spacing:4px;color:var(--text3);}

/* NAV */
.nav{display:flex;justify-content:center;flex-wrap:wrap;gap:3px;margin:22px auto 30px;background:var(--bg2);border:1px solid var(--bsoft);border-radius:50px;padding:4px;width:fit-content;box-shadow:0 4px 24px var(--shadow);}
.nav-btn{background:transparent;border:none;color:var(--text3);font-family:'Cinzel',serif;font-size:11px;letter-spacing:1.5px;padding:9px 16px;cursor:pointer;transition:all .25s;text-transform:uppercase;border-radius:40px;white-space:nowrap;}
.nav-btn.active{background:var(--gold);color:#1a0f00;box-shadow:0 2px 12px rgba(240,192,64,.4);}
.nav-btn:hover:not(.active){color:var(--gold);background:rgba(240,192,64,.1);}
.view{display:none;}.view.active{display:block;}

/* SEC TITLE */
.sec-ttl{font-family:'Cinzel',serif;font-size:11px;letter-spacing:3px;color:var(--gold2);text-transform:uppercase;margin-bottom:18px;display:flex;align-items:center;gap:12px;}
.sec-ttl::before,.sec-ttl::after{content:'';flex:1;height:1px;background:var(--bsoft);}

/* LEGEND */
.legend{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:16px;background:var(--bg2);border:1px solid var(--bsoft);border-radius:12px;padding:11px 15px;}
.leg-item{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--text2);font-family:'Cinzel',serif;letter-spacing:.4px;}
.leg-dot{width:12px;height:12px;border-radius:3px;flex-shrink:0;}
.leg-sep{color:var(--border);font-size:11px;letter-spacing:1px;font-family:'Cinzel',serif;}

/* VIEW TOGGLE */
.view-toggle{display:flex;border:1px solid var(--bsoft);border-radius:24px;overflow:hidden;width:fit-content;}
.vt-btn{background:transparent;border:none;color:var(--text3);font-family:'Cinzel',serif;font-size:11px;letter-spacing:1.5px;padding:9px 22px;cursor:pointer;transition:all .2s;text-transform:uppercase;}
.vt-btn.active{background:var(--gold);color:#1a0f00;}
.top-bar{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:14px;}

/* MONTH */
.month-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;}
.m-nav{background:var(--bg2);border:1px solid var(--bsoft);border-radius:50%;width:42px;height:42px;color:var(--gold);cursor:pointer;font-size:20px;display:flex;align-items:center;justify-content:center;transition:all .2s;box-shadow:0 2px 8px var(--shadow);}
.m-nav:hover{background:var(--gold);color:#1a0f00;}
.month-title{font-family:'Cinzel',serif;font-size:26px;color:var(--gold);letter-spacing:2px;}
.month-moon{font-size:16px;color:var(--text2);font-style:italic;margin-top:3px;}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;}
.cal-hdr-c{text-align:center;font-family:'Cinzel',serif;font-size:11px;letter-spacing:1.5px;color:var(--text3);padding:9px 0;}

.cal-day{display:flex;flex-direction:column;align-items:flex-start;padding:7px 6px 5px;border-radius:10px;cursor:pointer;border:1px solid var(--bsoft);min-height:94px;color:var(--text2);position:relative;overflow:hidden;transition:all .2s;background:var(--card);}
.cal-day:hover{border-color:var(--gold2);background:var(--card2);box-shadow:0 2px 12px var(--shadow);}
.cal-day.today{border-color:var(--gold)!important;box-shadow:0 0 0 2px rgba(240,192,64,.35)!important;}
.cal-day.other-m{opacity:.14;cursor:default;background:transparent;border-color:transparent;}
.cal-day.sel{border-color:var(--gold)!important;background:var(--card2)!important;box-shadow:0 0 0 2px rgba(240,192,64,.4)!important;}
.cal-day.blocked{background:rgba(85,96,112,.1)!important;border-color:rgba(85,96,112,.3)!important;}
.cal-day.phase-nova{background:var(--m-nova);}
.cal-day.phase-crescente{background:var(--m-crescente);}
.cal-day.phase-cheia{background:var(--m-cheia);}
.cal-day.phase-minguante{background:var(--m-minguante);}
.day-top{display:flex;align-items:center;justify-content:space-between;width:100%;margin-bottom:2px;}
.day-num{font-family:'Cinzel',serif;font-size:16px;font-weight:500;color:var(--text);}
.day-moon-em{font-size:15px;line-height:1;}
.day-phase-lbl{font-size:8px;color:var(--gold);letter-spacing:.3px;font-family:'Cinzel',serif;margin-bottom:1px;}
.day-sign{font-size:9.5px;color:var(--text3);font-style:italic;margin-bottom:2px;}
.ev-chips{display:flex;flex-direction:column;gap:2px;width:100%;}
.ev-chip{font-size:9.5px;padding:2px 6px;border-radius:4px;color:#fff;font-family:'Cinzel',serif;letter-spacing:.2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500;}
.tr-chip{font-size:9px;padding:2px 5px;border-radius:3px;border:1px solid rgba(240,192,64,.3);color:var(--gold2);background:rgba(240,192,64,.07);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-style:italic;}

/* WEEK */
.week-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.w-nav{background:var(--bg2);border:1px solid var(--bsoft);border-radius:50%;width:40px;height:40px;color:var(--gold);cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;transition:all .2s;}
.w-nav:hover{background:var(--gold);color:#1a0f00;}
.week-title{font-family:'Cinzel',serif;font-size:20px;color:var(--gold);letter-spacing:1px;}
.week-grid{display:grid;grid-template-columns:58px repeat(7,1fr);border:1px solid var(--bsoft);border-radius:14px;overflow:hidden;background:var(--bg2);box-shadow:0 4px 24px var(--shadow);}
.wg-corner{background:var(--bg3);border-right:1px solid var(--bsoft);border-bottom:1px solid var(--bsoft);}
.wg-day-hdr{background:var(--bg3);border-right:1px solid var(--bsoft);border-bottom:1px solid var(--bsoft);text-align:center;padding:9px 4px;cursor:pointer;transition:background .2s;}
.wg-day-hdr:hover{background:rgba(240,192,64,.08);}
.wg-day-hdr.today-col{background:rgba(240,192,64,.12);}
.wg-day-hdr.sel-col{background:rgba(240,192,64,.16);}
.wg-day-name{font-family:'Cinzel',serif;font-size:10px;letter-spacing:1px;color:var(--text3);}
.wg-day-num{font-family:'Cinzel',serif;font-size:22px;color:var(--gold);margin:2px 0;line-height:1;}
.wg-day-moon{font-size:13px;}
.wg-day-sign{font-size:9.5px;color:var(--text3);font-style:italic;margin-top:1px;}
.wg-time-cell{background:var(--bg3);border-right:1px solid var(--bsoft);border-bottom:1px solid var(--bsoft);text-align:right;padding:0 7px;display:flex;align-items:center;justify-content:flex-end;font-family:'Cinzel',serif;font-size:10px;color:var(--text3);letter-spacing:.5px;min-height:54px;}
.wg-slot{border-right:1px solid var(--bsoft);border-bottom:1px solid var(--bsoft);min-height:54px;position:relative;cursor:pointer;transition:background .15s;}
.wg-slot:hover{background:rgba(240,192,64,.06);}
.wg-slot.today-col{background:rgba(240,192,64,.04);}
.wg-slot.blocked-col{background:rgba(85,96,112,.08);}
.wg-slot.sel-col{background:rgba(240,192,64,.05);}
.wg-slot.tr-active{background-image:repeating-linear-gradient(45deg,rgba(240,192,64,.04),rgba(240,192,64,.04) 2px,transparent 2px,transparent 10px);}
.wg-ev{position:absolute;left:2px;right:2px;top:2px;border-radius:6px;padding:3px 6px;font-size:10px;color:#fff;font-family:'Cinzel',serif;overflow:hidden;cursor:pointer;z-index:3;box-shadow:0 2px 8px rgba(0,0,0,.35);border-left:3px solid rgba(255,255,255,.35);}
.wg-ev-time{font-size:9.5px;opacity:.9;}
.wg-ev-name{font-size:10px;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.wg-ev-tipo{font-size:9px;opacity:.75;}
.wg-add-hint{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .2s;color:var(--gold);font-size:22px;}
.wg-slot:hover .wg-add-hint{opacity:.45;}

/* DAY PANEL */
.day-panel{margin-top:26px;border-top:1px solid var(--bsoft);padding-top:24px;}
.dp-hdr{display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:16px;}
.dp-title{font-family:'Cinzel',serif;font-size:19px;color:var(--gold);letter-spacing:1px;line-height:1.3;}
.dp-acts{display:flex;gap:8px;flex-wrap:wrap;}
.sm-btn{font-size:12px;padding:7px 16px;border-radius:20px;border:1px solid var(--bsoft);background:transparent;color:var(--text2);cursor:pointer;font-family:'Cinzel',serif;transition:all .2s;letter-spacing:.8px;}
.sm-btn:hover{border-color:var(--gold2);color:var(--gold);}
.sm-btn.danger{border-color:rgba(239,68,68,.4);color:#ef4444;}
.sm-btn.safe{border-color:rgba(16,185,129,.4);color:#10b981;}
.ev-list{display:flex;flex-direction:column;gap:10px;margin-bottom:20px;}
.ev-item{display:flex;align-items:flex-start;gap:13px;padding:15px 18px;border-radius:13px;border:1px solid var(--bsoft);background:var(--card);box-shadow:0 2px 10px var(--shadow);transition:all .2s;border-left-width:5px;}
.ev-item:hover{box-shadow:0 4px 18px var(--shadow);border-color:var(--gold2);}
.ev-time{font-family:'Cinzel',serif;font-size:15px;color:var(--gold);min-width:52px;margin-top:2px;font-weight:500;}
.ev-info{flex:1;}
.ev-name{font-size:24px;color:var(--text);margin-bottom:3px;font-weight:500;}
.ev-sub{font-size:17px;color:var(--text2);font-style:italic;}
.ev-valor{font-size:17px;margin-top:5px;display:flex;align-items:center;gap:7px;flex-wrap:wrap;}
.ev-obs{font-size:15px;color:var(--text3);margin-top:6px;font-style:italic;border-left:3px solid var(--bsoft);padding-left:9px;line-height:1.5;}
.badge{display:inline-block;font-size:11px;letter-spacing:.8px;padding:3px 12px;border-radius:20px;font-family:'Cinzel',serif;}
.b-pago{background:rgba(0,200,128,.15);color:#00c880;border:1px solid rgba(0,200,128,.3);}
.b-pendente{background:rgba(240,192,64,.12);color:var(--gold);border:1px solid rgba(240,192,64,.25);}
.b-parcial{background:rgba(176,96,255,.15);color:#b060ff;border:1px solid rgba(176,96,255,.3);}
.ev-acts{display:flex;flex-direction:column;gap:5px;}
.btn-icon{background:none;border:1px solid var(--bsoft);color:var(--text3);cursor:pointer;font-size:15px;padding:5px 7px;border-radius:7px;transition:all .2s;line-height:1;}
.btn-icon:hover{background:var(--card2);border-color:var(--gold2);color:var(--gold);}
.transit-panel-day{background:rgba(240,192,64,.06);border:1px solid rgba(240,192,64,.22);border-radius:12px;padding:13px 17px;margin-bottom:13px;}
.tp-ttl{font-family:'Cinzel',serif;font-size:10px;letter-spacing:2px;color:var(--gold2);margin-bottom:9px;}
.tp-item{display:flex;gap:10px;padding:5px 0;border-bottom:1px solid rgba(240,192,64,.1);font-size:17px;color:var(--text2);}
.tp-item:last-child{border-bottom:none;}
.tp-planet{font-size:20px;min-width:26px;}
.add-btn{width:100%;padding:14px;background:transparent;border:1px dashed var(--gold2);border-radius:12px;color:var(--gold);font-family:'Cinzel',serif;font-size:13px;letter-spacing:2px;cursor:pointer;transition:all .3s;display:flex;align-items:center;justify-content:center;gap:8px;}
.add-btn:hover{background:rgba(240,192,64,.07);border-style:solid;}

/* FORMS */
.form-group{margin-bottom:16px;}
.form-label{font-size:13px;color:var(--text2);letter-spacing:1.5px;font-family:'Cinzel',serif;display:block;margin-bottom:7px;}
.form-input{width:100%;background:var(--bg2);border:1px solid var(--bsoft);border-radius:9px;padding:12px 15px;color:var(--text);font-family:'Cormorant Garamond',serif;font-size:19px;outline:none;transition:border-color .2s;}
.form-input:focus{border-color:var(--gold2);box-shadow:0 0 0 3px rgba(240,192,64,.15);}
.form-input::placeholder{color:var(--text3);}
.form-input option{background:var(--bg2);color:var(--text);}
textarea.form-input{resize:vertical;line-height:1.6;min-height:80px;}
.fr2{display:grid;grid-template-columns:1fr 1fr;gap:13px;}
.fr3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
.fr4{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:10px;}
.cc-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:10px;padding:12px 14px;background:rgba(240,192,64,.06);border:1px solid rgba(240,192,64,.2);border-radius:9px;}
.cc-row .form-group{margin-bottom:0;}

/* MODAL */
.modal-ov{position:fixed;inset:0;background:rgba(5,2,15,.78);backdrop-filter:blur(5px);z-index:200;display:flex;align-items:flex-start;justify-content:center;padding:18px;opacity:0;pointer-events:none;transition:opacity .3s;overflow-y:auto;}
.modal-ov.open{opacity:1;pointer-events:all;}
.modal{background:var(--bg2);border:1px solid var(--border);border-radius:22px;padding:34px;width:100%;max-width:580px;transform:translateY(24px);transition:transform .3s;margin:auto;box-shadow:0 16px 60px rgba(0,0,0,.7);}
.modal-ov.open .modal{transform:translateY(0);}
.modal-title{font-family:'Cinzel',serif;font-size:19px;color:var(--gold);letter-spacing:2px;margin-bottom:24px;text-align:center;}
.modal-actions{display:flex;gap:12px;margin-top:22px;}
.btn-cancel{flex:1;padding:12px;background:transparent;border:1px solid var(--bsoft);border-radius:10px;color:var(--text2);font-family:'Cinzel',serif;font-size:12px;letter-spacing:1.5px;cursor:pointer;transition:all .2s;}
.btn-cancel:hover{border-color:var(--border);color:var(--text);}
.btn-save{flex:2;padding:12px;background:var(--gold);border:none;border-radius:10px;color:#1a0f00;font-family:'Cinzel',serif;font-size:12px;letter-spacing:1.5px;cursor:pointer;font-weight:600;box-shadow:0 3px 14px rgba(240,192,64,.3);}
.btn-save:hover{background:#f8d060;}
.ac-box{display:none;background:var(--bg2);border:1px solid var(--border);border-radius:9px;overflow:hidden;box-shadow:0 6px 20px var(--shadow);margin-top:4px;}
.ac-item{padding:11px 15px;cursor:pointer;font-size:18px;color:var(--text);border-bottom:1px solid var(--bsoft);transition:background .15s;}
.ac-item:hover{background:var(--card2);}

/* ASPECT CHIPS in transit form */
.aspect-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:6px;}
.asp-btn{padding:8px 4px;border:1px solid var(--bsoft);border-radius:8px;background:transparent;color:var(--text2);cursor:pointer;font-family:'Cinzel',serif;font-size:11px;letter-spacing:.8px;text-align:center;transition:all .2s;}
.asp-btn:hover,.asp-btn.active{border-color:var(--gold2);color:var(--gold);background:rgba(240,192,64,.1);}
.asp-symbol{display:block;font-size:20px;margin-bottom:3px;}

/* CLIENTES */
.search-box{width:100%;padding:12px 17px;background:var(--bg2);border:1px solid var(--bsoft);border-radius:10px;color:var(--text);font-family:'Cormorant Garamond',serif;font-size:20px;outline:none;margin-bottom:22px;}
.search-box:focus{border-color:var(--gold2);}
.search-box::placeholder{color:var(--text3);}
.rank-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(170px,1fr));gap:13px;margin-bottom:32px;}
.rank-card{padding:18px 16px;background:var(--card);border:1px solid var(--bsoft);border-radius:14px;box-shadow:0 2px 10px var(--shadow);position:relative;transition:all .2s;overflow:hidden;}
.rank-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--gold2),var(--gold));}
.rank-card.top1::before{background:linear-gradient(90deg,#e8c060,#ffdf00,#e8c060);}
.rank-card:hover{box-shadow:0 4px 20px var(--shadow);transform:translateY(-2px);}
.rank-num{position:absolute;top:14px;right:14px;font-family:'Cinzel',serif;font-size:22px;color:var(--bsoft);font-weight:600;line-height:1;}
.rank-num.gold{color:var(--gold2);}
.rank-name{font-size:16px;color:var(--text);font-weight:500;margin-bottom:4px;padding-right:30px;line-height:1.3;margin-top:8px;}
.rank-count{font-family:'Cinzel',serif;font-size:13px;color:var(--gold);}
.rank-fat{font-size:12px;color:var(--text3);margin-top:2px;font-style:italic;}

.reativ-card{display:flex;align-items:center;gap:13px;padding:13px 17px;background:var(--card);border:1px solid var(--bsoft);border-radius:11px;margin-bottom:9px;box-shadow:0 1px 6px var(--shadow);}
.reativ-av{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--gold2),var(--gold3));display:flex;align-items:center;justify-content:center;font-family:'Cinzel',serif;font-size:14px;color:#fff;flex-shrink:0;}
.reativ-info{flex:1;}
.reativ-name{font-size:18px;color:var(--text);font-weight:500;}
.reativ-dias{font-size:14px;color:var(--text3);font-style:italic;}

.client-card{background:var(--card);border:1px solid var(--bsoft);border-radius:13px;margin-bottom:12px;box-shadow:0 2px 10px var(--shadow);overflow:hidden;}
.client-hdr{display:flex;align-items:center;gap:14px;padding:16px 20px;cursor:pointer;transition:background .2s;}
.client-hdr:hover{background:rgba(240,192,64,.04);}
.c-avatar{width:44px;height:44px;border-radius:50%;background:linear-gradient(135deg,var(--gold2),var(--gold3));display:flex;align-items:center;justify-content:center;font-family:'Cinzel',serif;font-size:15px;color:#fff;flex-shrink:0;box-shadow:0 2px 8px rgba(0,0,0,.3);}
.c-name{font-size:20px;color:var(--text);font-weight:500;}
.c-meta{font-size:14px;color:var(--text3);font-style:italic;margin-top:2px;}
.c-stats{display:flex;gap:18px;flex-wrap:wrap;padding:0 20px 12px;}
.c-stat{font-size:14px;color:var(--text3);}
.c-stat b{color:var(--gold);font-weight:500;}
.c-actions{padding:0 20px 13px;display:flex;gap:9px;flex-wrap:wrap;}
.c-btn{font-size:12px;padding:6px 16px;border-radius:18px;border:1px solid var(--bsoft);background:transparent;color:var(--text2);cursor:pointer;font-family:'Cinzel',serif;letter-spacing:1px;transition:all .2s;}
.c-btn:hover{border-color:var(--gold2);color:var(--gold);}
.hist-box{display:none;border-top:1px solid var(--bsoft);background:var(--bg3);}
.hist-box.open{display:block;}
.hist-item{font-size:14px;color:var(--text2);padding:9px 20px;border-bottom:1px solid rgba(255,255,255,.03);display:flex;gap:11px;align-items:center;}
.hist-item:last-child{border-bottom:none;}
.hist-date{color:var(--gold);font-family:'Cinzel',serif;min-width:86px;font-size:13px;font-weight:500;}
.hist-pdf{margin-left:auto;background:none;border:1px solid var(--bsoft);border-radius:6px;padding:4px 10px;font-size:12px;cursor:pointer;color:var(--text3);transition:all .2s;}
.hist-pdf:hover{background:var(--card2);border-color:var(--gold2);color:var(--gold);}

/* PUBLICAÇÕES */
.pub-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:15px;margin-bottom:22px;}
.pub-card{background:var(--card);border:1px solid var(--bsoft);border-radius:13px;overflow:hidden;box-shadow:0 2px 10px var(--shadow);transition:all .2s;}
.pub-card:hover{box-shadow:0 5px 20px var(--shadow);transform:translateY(-2px);}
.pub-img-wrap{width:100%;aspect-ratio:1;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-size:36px;color:var(--text3);overflow:hidden;}
.pub-img-wrap img{width:100%;height:100%;object-fit:cover;}
.pub-body{padding:11px 14px;}
.pub-tag{font-size:11px;font-family:'Cinzel',serif;color:var(--gold);letter-spacing:1px;margin-bottom:3px;}
.pub-title{font-size:16px;color:var(--text);font-weight:500;margin-bottom:2px;}
.pub-date{font-size:12px;color:var(--text3);font-style:italic;}
.pub-del{display:block;width:100%;padding:7px;border:none;background:none;border-top:1px solid var(--bsoft);color:var(--text3);cursor:pointer;font-size:12px;transition:all .2s;text-align:center;}
.pub-del:hover{background:rgba(239,68,68,.08);color:#ef4444;}

/* GESTÃO FINANCEIRA */
.fin-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:13px;margin-bottom:28px;}
.fin-card{padding:22px;background:var(--card);border:1px solid var(--bsoft);border-radius:13px;text-align:center;box-shadow:0 2px 10px var(--shadow);}
.fin-icon{font-size:28px;display:block;margin-bottom:8px;}
.fin-num{font-family:'Cinzel',serif;font-size:26px;color:var(--gold);display:block;font-weight:500;}
.fin-lbl{font-size:13px;color:var(--text3);margin-top:4px;}
.bar-item{display:flex;align-items:center;gap:11px;margin-bottom:13px;}
.bar-lbl{font-size:16px;color:var(--text2);width:155px;flex-shrink:0;}
.bar-track{flex:1;height:9px;background:var(--bg3);border-radius:5px;overflow:hidden;border:1px solid var(--bsoft);}
.bar-fill{height:100%;border-radius:5px;}
.bar-val{font-family:'Cinzel',serif;font-size:13px;color:var(--gold);min-width:72px;text-align:right;}

/* SERVIÇOS */
.svc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:13px;margin-bottom:24px;}
.svc-card{padding:19px;background:var(--card);border:1px solid var(--bsoft);border-left:4px solid;border-radius:13px;box-shadow:0 2px 10px var(--shadow);position:relative;transition:all .2s;}
.svc-card:hover{box-shadow:0 4px 18px var(--shadow);}
.svc-name{font-size:19px;color:var(--text);font-weight:500;margin-bottom:4px;}
.svc-valor{font-family:'Cinzel',serif;font-size:17px;color:var(--gold);}
.svc-del{position:absolute;top:11px;right:13px;background:none;border:none;color:var(--text3);cursor:pointer;font-size:15px;transition:color .2s;}
.svc-del:hover{color:#ef4444;}

/* LISTA */
.lst-ev{display:flex;align-items:center;gap:13px;padding:14px 18px;background:var(--card);border:1px solid var(--bsoft);border-left-width:4px;border-radius:12px;margin-bottom:9px;box-shadow:0 1px 6px var(--shadow);transition:all .2s;}
.lst-ev:hover{box-shadow:0 3px 14px var(--shadow);}
.lst-date{font-family:'Cinzel',serif;font-size:13px;color:var(--gold);min-width:72px;line-height:1.5;font-weight:500;}
.lst-info{flex:1;}
.lst-name{font-size:19px;color:var(--text);font-weight:500;}
.lst-sub{font-size:15px;color:var(--text2);font-style:italic;margin-top:2px;}
.lst-val{font-size:14px;margin-top:3px;}
.no-ev{text-align:center;padding:50px 0;color:var(--text3);font-style:italic;font-size:19px;}

/* EDITORIAL */
.ed-week-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:8px;}
.ed-day-hdr{text-align:center;font-family:'Cinzel',serif;font-size:10px;letter-spacing:1.5px;color:var(--text3);padding:8px 0;}
.ed-day-col{min-height:120px;background:var(--card);border:1px solid var(--bsoft);border-radius:10px;padding:7px 5px;cursor:pointer;transition:all .2s;position:relative;}
.ed-day-col:hover{border-color:var(--gold2);background:var(--card2);}
.ed-day-col.today-ed{border-color:var(--gold)!important;box-shadow:0 0 0 2px rgba(240,192,64,.3);}
.ed-day-num{font-family:'Cinzel',serif;font-size:13px;color:var(--text);margin-bottom:3px;display:flex;align-items:center;justify-content:space-between;}
.ed-day-moon{font-size:12px;}
.ed-post-chip{font-size:10px;padding:3px 7px;border-radius:5px;color:#fff;font-family:'Cinzel',serif;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;transition:opacity .2s;}
.ed-post-chip:hover{opacity:.85;}
.ed-add-hint{font-size:18px;color:var(--bsoft);text-align:center;margin-top:4px;opacity:0;transition:opacity .2s;}
.ed-day-col:hover .ed-add-hint{opacity:1;}

.ed-month-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;}
.ed-month-day{min-height:80px;background:var(--card);border:1px solid var(--bsoft);border-radius:8px;padding:6px 5px;cursor:pointer;transition:all .2s;position:relative;}
.ed-month-day:hover{border-color:var(--gold2);background:var(--card2);}
.ed-month-day.other-m{opacity:.15;cursor:default;background:transparent;border-color:transparent;}
.ed-month-day.today-ed{border-color:var(--gold)!important;}

.ed-post-card{display:flex;align-items:flex-start;gap:13px;padding:14px 18px;background:var(--card);border:1px solid var(--bsoft);border-radius:12px;margin-bottom:10px;box-shadow:0 1px 6px var(--shadow);border-left-width:5px;transition:all .2s;}
.ed-post-card:hover{box-shadow:0 3px 14px var(--shadow);}
.ed-post-info{flex:1;}
.ed-post-title{font-size:19px;color:var(--text);font-weight:500;margin-bottom:3px;}
.ed-post-meta{font-size:14px;color:var(--text2);font-style:italic;margin-bottom:4px;}
.ed-post-copy{font-size:14px;color:var(--text3);line-height:1.5;margin-top:5px;font-style:italic;border-left:3px solid var(--bsoft);padding-left:8px;}
.ed-status-badge{display:inline-block;font-size:11px;padding:2px 10px;border-radius:14px;font-family:'Cinzel',serif;letter-spacing:.6px;}
.st-ideia{background:rgba(99,102,241,.15);color:#6366f1;border:1px solid rgba(99,102,241,.3);}
.st-producao{background:rgba(245,158,11,.15);color:#f59e0b;border:1px solid rgba(245,158,11,.3);}
.st-agendado{background:rgba(236,72,153,.15);color:#ec4899;border:1px solid rgba(236,72,153,.3);}
.st-publicado{background:rgba(16,185,129,.15);color:#10b981;border:1px solid rgba(16,185,129,.3);}

@media print{body *{visibility:hidden;}#pdf-area,#pdf-area *{visibility:visible;}#pdf-area{position:absolute;top:0;left:0;width:100%;background:#fff;color:#111;}}
#pdf-area{display:none;}
</style>
</head>
<body>
<div class="app">
  <div class="hero">
    <div class="hero-orn">✦ &nbsp; Astrologia &nbsp;·&nbsp; Cartomancia &nbsp; ✦</div>
    <h1 class="hero-name">Mariana Di Falcco</h1>
    <div class="hero-title">Agenda Astral de Atendimentos</div>
  </div>

  <div class="nav">
    <button class="nav-btn active" onclick="switchView('calendar',this)">Calendário</button>
    <button class="nav-btn" onclick="switchView('lista',this)">Atendimentos</button>
    <button class="nav-btn" onclick="switchView('clientes',this)">Clientes</button>
    <button class="nav-btn" onclick="switchView('publicacoes',this)">Publicações</button>
    <button class="nav-btn" onclick="switchView('editorial',this)">Editorial</button>
    <button class="nav-btn" onclick="switchView('transitos',this)">Trânsitos</button>
    <button class="nav-btn" onclick="switchView('servicos',this)">Serviços</button>
    <button class="nav-btn" onclick="switchView('financeiro',this)">Financeiro</button>
    <button class="nav-btn" onclick="switchView('backup',this)">💾 Backup</button>
  </div>

  <!-- CALENDÁRIO -->
  <div class="view active" id="view-calendar">
    <div class="top-bar">
      <div class="view-toggle">
        <button class="vt-btn active" id="vt-mes" onclick="setCalView('mes')">Mês</button>
        <button class="vt-btn" id="vt-sem" onclick="setCalView('semana')">Semana</button>
      </div>
      <button class="add-btn" onclick="openModal(null,null)" style="width:auto;padding:9px 22px;border-style:solid;">✦ Novo Atendimento</button>
    </div>
    <div class="legend">
      <span class="leg-sep">SERVIÇOS:</span>
      <div class="leg-item"><div class="leg-dot" style="background:var(--c-mapa)"></div>Mapa Natal</div>
      <div class="leg-item"><div class="leg-dot" style="background:var(--c-solar)"></div>Solar</div>
      <div class="leg-item"><div class="leg-dot" style="background:var(--c-sinastria)"></div>Sinastria</div>
      <div class="leg-item"><div class="leg-dot" style="background:var(--c-tarot)"></div>Tarot</div>
      <div class="leg-item"><div class="leg-dot" style="background:var(--c-cigano)"></div>Cigano</div>
      <div class="leg-item"><div class="leg-dot" style="background:var(--c-sibilla)"></div>Sibilla</div>
      <div class="leg-item"><div class="leg-dot" style="background:var(--c-geral)"></div>Geral</div>
      <span class="leg-sep" style="margin-left:6px">LUAS:</span>
      <div class="leg-item"><div class="leg-dot" style="background:var(--m-nova);border:1px solid #8060c0"></div>Nova</div>
      <div class="leg-item"><div class="leg-dot" style="background:var(--m-crescente);border:1px solid #00c880"></div>Crescente</div>
      <div class="leg-item"><div class="leg-dot" style="background:var(--m-cheia);border:1px solid var(--gold)"></div>Cheia</div>
      <div class="leg-item"><div class="leg-dot" style="background:var(--m-minguante);border:1px solid #a060e0"></div>Minguante</div>
    </div>
    <div id="month-view">
      <div class="month-header">
        <button class="m-nav" onclick="changeMonth(-1)">&#8592;</button>
        <div style="text-align:center"><div class="month-title" id="month-title"></div><div class="month-moon" id="month-moon"></div></div>
        <button class="m-nav" onclick="changeMonth(1)">&#8594;</button>
      </div>
      <div class="cal-grid" id="cal-grid"></div>
    </div>
    <div id="week-view" style="display:none;">
      <div class="week-header">
        <button class="w-nav" onclick="changeWeek(-1)">&#8592;</button>
        <div class="week-title" id="week-title"></div>
        <button class="w-nav" onclick="changeWeek(1)">&#8594;</button>
      </div>
      <div class="week-grid" id="week-grid"></div>
    </div>
    <div class="day-panel">
      <div class="dp-hdr">
        <div class="dp-title" id="dp-title">Selecione um dia</div>
        <div class="dp-acts">
          <button class="sm-btn danger" id="block-btn" onclick="toggleBlock()" style="display:none">⊘ Bloquear</button>
        </div>
      </div>
      <div id="day-transit-panel"></div>
      <div class="ev-list" id="ev-list"></div>
      <button class="add-btn" id="add-btn" onclick="openModal(null,null)" style="display:none">✦ &nbsp; Novo Atendimento</button>
    </div>
  </div>

  <!-- LISTA -->
  <div class="view" id="view-lista">
    <div style="display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap;">
      <select class="form-input" id="fl-status" onchange="renderLista()" style="flex:1;min-width:130px;font-size:17px;padding:10px 13px;">
        <option value="">Todos os status</option><option value="pago">Pago</option><option value="pendente">Pendente</option><option value="parcial">Parcial</option>
      </select>
      <select class="form-input" id="fl-tipo" onchange="renderLista()" style="flex:1;min-width:130px;font-size:17px;padding:10px 13px;">
        <option value="">Todos os serviços</option>
      </select>
    </div>
    <div id="lista-content"></div>
    <button class="add-btn" onclick="openModal(null,null)">✦ &nbsp; Novo Atendimento</button>
  </div>

  <!-- CLIENTES -->
  <div class="view" id="view-clientes">
    <input class="search-box" id="cl-search" type="text" placeholder="Buscar cliente por nome..." oninput="renderClientes()">
    <div class="sec-ttl">Ranking de Clientes</div>
    <div class="rank-grid" id="rank-grid"></div>
    <div class="sec-ttl">Clientes para Reativar</div>
    <div id="reativacao-list" style="margin-bottom:30px;"></div>
    <div class="sec-ttl">Todas as Clientes</div>
    <div id="clientes-content"></div>
    <button class="add-btn" style="margin-top:8px" onclick="openModal(null,null)">✦ &nbsp; Novo Atendimento</button>
  </div>

  <!-- PUBLICAÇÕES -->
  <div class="view" id="view-publicacoes">
    <div style="display:flex;gap:10px;margin-bottom:20px;flex-wrap:wrap;align-items:center;">
      <select class="form-input" id="pub-filtro" onchange="renderPublicacoes()" style="flex:1;min-width:140px;max-width:240px;font-size:17px;padding:10px 13px;">
        <option value="">Todas as categorias</option>
        <option value="Trânsito">Trânsito</option><option value="Lua">Lua</option><option value="Tarot">Tarot</option>
        <option value="Signo">Signo</option><option value="Dica">Dica</option><option value="Outro">Outro</option>
      </select>
      <button class="add-btn" onclick="openPubModal()" style="width:auto;padding:10px 22px;border-style:solid;">✦ Nova Publicação</button>
    </div>
    <div class="pub-grid" id="pub-grid"></div>
  </div>

  <!-- TRÂNSITOS -->
  <div class="view" id="view-transitos">
    <div style="display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap;">
      <select class="form-input" id="tr-filtro" onchange="renderTransitos()" style="flex:1;min-width:140px;max-width:260px;font-size:17px;padding:10px 13px;">
        <option value="">Todos os planetas</option>
        <option value="☀️">☀️ Sol</option><option value="🌙">🌙 Lua</option><option value="☿">☿ Mercúrio</option>
        <option value="♀">♀ Vênus</option><option value="♂">♂ Marte</option><option value="♃">♃ Júpiter</option>
        <option value="♄">♄ Saturno</option><option value="⛢">⛢ Urano</option><option value="♆">♆ Netuno</option><option value="♇">♇ Plutão</option>
      </select>
      <select class="form-input" id="tr-asp-filtro" onchange="renderTransitos()" style="flex:1;min-width:140px;max-width:240px;font-size:17px;padding:10px 13px;">
        <option value="">Todos os aspectos</option>
        <option value="Conjunção">☌ Conjunção</option><option value="Oposição">☍ Oposição</option>
        <option value="Trígono">△ Trígono</option><option value="Quadratura">□ Quadratura</option>
        <option value="Sextil">⚹ Sextil</option><option value="Ingresso">→ Ingresso</option>
        <option value="Retrógrado">℞ Retrógrado</option><option value="Direto">D Direto</option>
      </select>
    </div>
    <div id="transitos-list" style="margin-bottom:20px;"></div>
    <button class="add-btn" onclick="openTransitModal()">✦ &nbsp; Adicionar Trânsito</button>
  </div>

  <!-- SERVIÇOS -->
  <div class="view" id="view-servicos">
    <div class="svc-grid" id="svc-grid"></div>
    <div style="background:var(--card);border:1px solid var(--bsoft);border-radius:15px;padding:26px;box-shadow:0 2px 10px var(--shadow);">
      <div style="font-family:'Cinzel',serif;font-size:13px;color:var(--gold);margin-bottom:17px;letter-spacing:1.5px;">✦ Adicionar Serviço</div>
      <div class="fr2" style="margin-bottom:13px;">
        <div class="form-group" style="margin-bottom:0"><label class="form-label">Nome</label><input class="form-input" id="s-nome" type="text" placeholder="ex: Mapa Natal"></div>
        <div class="form-group" style="margin-bottom:0"><label class="form-label">Valor (R$)</label><input class="form-input" id="s-valor" type="number" placeholder="250"></div>
      </div>
      <div class="form-group"><label class="form-label">Cor no calendário</label>
        <select class="form-input" id="s-cor">
          <option value="#b060ff">🟣 Roxo — Mapa Natal</option><option value="#ffb020">🟡 Âmbar — Solar</option>
          <option value="#ff4d94">🩷 Rosa — Sinastria</option><option value="#ff4444">🔴 Vermelho — Tarot</option>
          <option value="#ff7820">🟠 Laranja — Cigano</option><option value="#00d0f0">🔵 Ciano — Sibilla</option>
          <option value="#00c880">🟢 Verde — Geral</option>
        </select></div>
      <button class="add-btn" onclick="addService()">✦ &nbsp; Salvar Serviço</button>
    </div>
  </div>

  <!-- EDITORIAL -->
  <div class="view" id="view-editorial">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:20px;">
      <div style="display:flex;gap:8px;align-items:center;">
        <button class="m-nav" onclick="edChangeWeek(-1)">&#8592;</button>
        <span class="month-title" id="ed-title" style="font-size:20px;"></span>
        <button class="m-nav" onclick="edChangeWeek(1)">&#8594;</button>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;">
        <select class="form-input" id="ed-mode" onchange="renderEditorial()" style="font-size:15px;padding:8px 12px;max-width:160px;">
          <option value="semana">Semana</option>
          <option value="mes">Mês</option>
        </select>
        <button class="add-btn" onclick="openEdModal(null)" style="width:auto;padding:9px 20px;border-style:solid;">✦ Novo Post</button>
      </div>
    </div>
    <div class="legend" style="margin-bottom:16px;">
      <span class="leg-sep">STATUS:</span>
      <div class="leg-item"><div class="leg-dot" style="background:#6366f1"></div>Ideia</div>
      <div class="leg-item"><div class="leg-dot" style="background:#f59e0b"></div>Em produção</div>
      <div class="leg-item"><div class="leg-dot" style="background:#10b981"></div>Publicado</div>
      <div class="leg-item"><div class="leg-dot" style="background:#ec4899"></div>Agendado</div>
      <span class="leg-sep" style="margin-left:6px">FORMATO:</span>
      <div class="leg-item"><div class="leg-dot" style="background:var(--c-sibilla)"></div>Feed</div>
      <div class="leg-item"><div class="leg-dot" style="background:#f97316"></div>Story</div>
      <div class="leg-item"><div class="leg-dot" style="background:#a855f7"></div>Reels</div>
    </div>
    <div id="ed-grid"></div>
    <div class="sec-ttl" style="margin-top:28px;">Todos os Posts</div>
    <div id="ed-list"></div>
  </div>

  <!-- FINANCEIRO -->
  <div class="view" id="view-financeiro">
    <div style="display:flex;gap:10px;margin-bottom:22px;flex-wrap:wrap;">
      <select class="form-input" id="r-periodo" onchange="renderFinanceiro()" style="font-size:17px;padding:10px 13px;max-width:250px;">
        <option value="tudo">Todo o período</option><option value="mes">Este mês</option><option value="ano">Este ano</option>
      </select>
    </div>
    <div class="fin-stats" id="fin-stats"></div>
    <div class="sec-ttl">Faturamento por serviço</div>
    <div id="fat-bar" style="margin-bottom:32px;"></div>
    <div class="sec-ttl">Por forma de pagamento</div>
    <div id="forma-bar" style="margin-bottom:32px;"></div>
    <div class="sec-ttl">Por signo solar</div>
    <div id="sign-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;"></div>
  </div>

  <!-- BACKUP -->
  <div class="view" id="view-backup">
    <!-- STATUS BAR -->
    <div id="backup-status-bar" style="margin-bottom:24px;padding:14px 20px;border-radius:12px;border:1px solid var(--bsoft);background:var(--card);display:flex;align-items:center;gap:14px;">
      <div id="backup-status-icon" style="font-size:28px;">💾</div>
      <div>
        <div id="backup-status-msg" style="font-size:17px;color:var(--text);font-weight:500;">Verificando sincronização...</div>
        <div id="backup-status-sub" style="font-size:14px;color:var(--text3);margin-top:2px;font-style:italic;"></div>
      </div>
    </div>

    <!-- AUTO BACKUP -->
    <div class="sec-ttl">Backup Automático</div>
    <div style="background:var(--card);border:1px solid var(--bsoft);border-radius:14px;padding:24px;margin-bottom:22px;box-shadow:0 2px 10px var(--shadow);">
      <p style="font-size:17px;color:var(--text2);line-height:1.7;margin-bottom:18px;">Seus dados são salvos automaticamente no navegador. Para não perder nada ao trocar de dispositivo ou limpar o cache, exporte o JSON e guarde em local seguro.</p>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <button onclick="exportJSON()" style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:10px;border:none;background:var(--gold);color:#1a0f00;font-family:'Cinzel',serif;font-size:12px;letter-spacing:1.5px;cursor:pointer;font-weight:600;box-shadow:0 2px 10px rgba(240,192,64,.3);">⬇ Exportar JSON</button>
        <button onclick="document.getElementById('import-file').click()" style="display:inline-flex;align-items:center;gap:8px;padding:12px 22px;border-radius:10px;border:1px solid var(--bsoft);background:transparent;color:var(--text2);font-family:'Cinzel',serif;font-size:12px;letter-spacing:1.5px;cursor:pointer;">⬆ Importar JSON</button>
      </div>
      <input type="file" id="import-file" accept=".json" style="display:none" onchange="importJSON(this)">
      <p id="import-msg" style="margin-top:12px;font-size:14px;color:var(--text3);font-style:italic;"></p>
      <div id="backup-summary" style="margin-top:18px;font-size:14px;color:var(--text3);line-height:1.9;"></div>
    </div>

    <!-- GOOGLE DRIVE -->
