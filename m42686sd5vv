  const rEl=document.getElementById('reativacao-list');
  if(reativ.length){
    let rh='';
    reativ.forEach(c=>{
      const ini=c.nome.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase();
      const last=c.evs.sort((a,b)=>b.date.localeCompare(a.date))[0];
      const diff=Math.round((today-new Date(last.date+'T12:00:00'))/86400000);
      const wb=encodeURIComponent(`Olá ${c.nome}! Há algum tempo não nos encontramos. Que tal marcarmos um atendimento? 🌙✨`);
