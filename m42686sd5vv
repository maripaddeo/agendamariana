/* MONTH */
function changeMonth(d){currentDate.setMonth(currentDate.getMonth()+d);renderCalendar();}
function renderCalendar(){
  const y=currentDate.getFullYear(),m=currentDate.getMonth();
  document.getElementById('month-title').textContent=months[m]+' '+y;
  const midDS=`${y}-${String(m+1).padStart(2,'0')}-15`;
  const midM=getMoonPhase(midDS),midSign=MOON_SIGNS[midDS]||'';
  const midEmoji=midSign?SIGN_EMOJI[midSign]||'':'';
  document.getElementById('month-moon').textContent=`${midM.e}${midSign?' — '+midEmoji+' ☽ '+midSign:''}`;
  const g=document.getElementById('cal-grid');
  g.innerHTML=wdays.map(d=>`<div class="cal-hdr-c">${d}</div>`).join('');
  const first=new Date(y,m,1).getDay(),total=new Date(y,m+1,0).getDate(),prev=new Date(y,m,0).getDate(),today=new Date();
  for(let i=0;i<first;i++) g.innerHTML+=`<div class="cal-day other-m"><div class="day-top"><span class="day-num">${prev-first+i+1}</span></div></div>`;
  for(let d=1;d<=total;d++){
    const ds=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const isT=today.getDate()===d&&today.getMonth()===m&&today.getFullYear()===y;
    const isB=blocked.includes(ds),moon=getMoonPhase(ds),moonSign=MOON_SIGNS[ds]||'',moonEmoji=moonSign?SIGN_EMOJI[moonSign]||'':'';
    const dayEvs=events.filter(e=>e.date===ds).slice(0,3),dayTr=transits.filter(t=>t.dateIni<=ds&&(!t.dateFim||t.dateFim>=ds)).slice(0,2);
    const isMain=!!MOON_PHASES[ds];
    const phCls={'nova':'phase-nova','crescente':'phase-crescente','cheia':'phase-cheia','minguante':'phase-minguante'};
    let cls='cal-day '+(phCls[moon.f]||'');
    if(isT) cls+=' today';if(isB) cls+=' blocked';if(selectedDay===ds) cls+=' sel';
    const chips=dayEvs.map(ev=>`<div class="ev-chip" style="background:${svcColor(ev.tipo)}">${ev.hora?ev.hora.slice(0,5)+' ':''} ${ev.nome.split(' ')[0]}</div>`).join('')
      +dayTr.map(t=>`<div class="tr-chip">${t.planeta}${t.aspecto?t.aspecto.charAt(0):''} ${t.titulo.slice(0,12)}${t.titulo.length>12?'…':''}</div>`).join('');
    g.innerHTML+=`<div class="${cls}" onclick="selectDay('${ds}')">
      <div class="day-top"><span class="day-num">${d}</span><span class="day-moon-em">${moon.e}</span></div>
      ${isMain?`<div class="day-phase-lbl">${moon.l}</div>`:''}
      ${moonSign?`<div class="day-sign">${moonEmoji} ☽ ${moonSign}</div>`:''}
      <div class="ev-chips">${chips}</div>
    </div>`;
  }
  for(let i=1;i<=42-first-total;i++) g.innerHTML+=`<div class="cal-day other-m"><div class="day-top"><span class="day-num">${i}</span></div></div>`;
  if(selectedDay) renderDayPanel(selectedDay);
}

