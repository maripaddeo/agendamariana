function openModal(date,hora){
  editingId=null;
  document.getElementById('modal-title').textContent='✦ Novo Atendimento ✦';
  document.getElementById('modal-save-btn').textContent='✦ Confirmar Atendimento';
  document.getElementById('modal-save-btn').onclick=saveEvent;
  ['f-nome','f-obs','f-valor','f-bandeira','f-portador'].forEach(i=>{const el=document.getElementById(i);if(el) el.value='';});
  ['f-tipo','f-signo','f-slua','f-asc','f-forma'].forEach(i=>document.getElementById(i).value='');
  document.getElementById('f-status').value='pendente';document.getElementById('f-dur').value='60';
  document.getElementById('f-parcelas').value='1';
  document.getElementById('f-data').value=date||selectedDay||new Date().toISOString().split('T')[0];
  document.getElementById('f-hora').value=hora||'';
  document.getElementById('ac-box').style.display='none';
  document.getElementById('cc-fields').style.display='none';
  populateSvc();document.getElementById('modal').classList.add('open');
}
function saveEvent(){
  const nome=document.getElementById('f-nome').value.trim(),data=document.getElementById('f-data').value;
  if(!nome||!data) return;
  events.push({id:Date.now().toString(),nome,date:data,
    hora:document.getElementById('f-hora').value,tipo:document.getElementById('f-tipo').value,
    dur:document.getElementById('f-dur').value,valor:document.getElementById('f-valor').value,
    status:document.getElementById('f-status').value,forma:document.getElementById('f-forma').value,
    bandeira:document.getElementById('f-bandeira').value,parcelas:document.getElementById('f-parcelas').value,
    portador:document.getElementById('f-portador').value,
    signo:document.getElementById('f-signo').value,slua:document.getElementById('f-slua').value,
    asc:document.getElementById('f-asc').value,obs:document.getElementById('f-obs').value.trim()});
  save();closeModal();selectedDay=data;
  if(calView==='mes') renderCalendar(); else renderWeek();
  renderDayPanel(data);
}
function deleteEv(id){events=events.filter(e=>e.id!==id);save();if(selectedDay) renderDayPanel(selectedDay);if(calView==='mes') renderCalendar(); else renderWeek();}

