        <button class="c-btn" onclick="window.open('https://wa.me/?text=${wb}','_blank')">📱 WhatsApp</button></div>`;
    });
    rEl.innerHTML=rh;
  } else rEl.innerHTML=`<p style="color:var(--text3);font-style:italic;font-size:16px;margin-bottom:20px">Nenhuma cliente inativa há mais de 90 dias. ✦</p>`;
  // LISTA COMPLETA
  const clientes=all.filter(c=>!q||c.nome.toLowerCase().includes(q));
  if(!clientes.length){document.getElementById('clientes-content').innerHTML=`<div class="no-ev">Nenhuma cliente encontrada.</div>`;return;}
  let html='';
  clientes.forEach(c=>{
    const ini=c.nome.split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase();
    const sorted=c.evs.sort((a,b)=>b.date.localeCompare(a.date));
    const last=sorted[0];const[,lm,ld]=last.date.split('-');
