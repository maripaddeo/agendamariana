/* MODAL ATENDIMENTO */
function acUpdate(){
  const q=document.getElementById('f-nome').value.toLowerCase().trim();
  const box=document.getElementById('ac-box');
  if(q.length<2){box.style.display='none';return;}
  const nomes=[...new Set(events.map(e=>e.nome))].filter(n=>n.toLowerCase().includes(q)).slice(0,5);
  if(!nomes.length){box.style.display='none';return;}
  box.style.display='block';
  box.innerHTML=nomes.map(n=>`<div class="ac-item" onclick="pickC('${n.replace(/'/g,"\\'")}')">${n}</div>`).join('');
}
function pickC(n){
  document.getElementById('f-nome').value=n;document.getElementById('ac-box').style.display='none';
  const prev=events.filter(e=>e.nome===n).sort((a,b)=>b.date.localeCompare(a.date))[0];
  if(prev){if(prev.signo) document.getElementById('f-signo').value=prev.signo;if(prev.slua) document.getElementById('f-slua').value=prev.slua;if(prev.asc) document.getElementById('f-asc').value=prev.asc;}
}
function populateSvc(){
  const sel=document.getElementById('f-tipo'),pv=sel.value;
  sel.innerHTML='<option value="">Selecione...</option>';
  if(services.length) services.forEach(s=>sel.innerHTML+=`<option value="${s.nome}" data-v="${s.valor||0}">${s.nome}${s.valor?' — R$ '+parseFloat(s.valor).toFixed(0):''}</option>`);
  else ['Mapa Natal','Previsão Solar','Sinastria','Tarot','Baralho Cigano','Sibilla','Consulta Geral'].forEach(t=>sel.innerHTML+=`<option value="${t}">${t}</option>`);
  sel.value=pv;
  const ft=document.getElementById('fl-tipo');
  if(ft){const fpv=ft.value;ft.innerHTML='<option value="">Todos os serviços</option>';(services.length?services.map(s=>s.nome):['Mapa Natal','Previsão Solar','Sinastria','Tarot','Baralho Cigano','Sibilla','Consulta Geral']).forEach(t=>ft.innerHTML+=`<option value="${t}">${t}</option>`);ft.value=fpv;}
}
function preencherValor(){
  const sel=document.getElementById('f-tipo'),opt=sel.options[sel.selectedIndex];
  const v=opt?opt.getAttribute('data-v'):'';if(v&&v!=='0') document.getElementById('f-valor').value=v;
