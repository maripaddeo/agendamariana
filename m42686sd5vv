/* ── EDIÇÃO DE ATENDIMENTO ── */
let editingId=null;

function openEditModal(id){
  const ev=events.find(e=>e.id===id);if(!ev) return;
  editingId=id;

  // Switch modal to edit mode
  document.getElementById('modal-title').textContent='✏️ Editar Atendimento';
  document.getElementById('modal-save-btn').textContent='✦ Salvar Alterações';
  document.getElementById('modal-save-btn').onclick=updateEvent;

  // Fill all fields
  document.getElementById('f-data').value=ev.date||'';
  document.getElementById('f-hora').value=ev.hora||'';
  document.getElementById('f-nome').value=ev.nome||'';
  document.getElementById('f-dur').value=ev.dur||'60';
  document.getElementById('f-valor').value=ev.valor||'';
  document.getElementById('f-status').value=ev.status||'pendente';
  document.getElementById('f-forma').value=ev.forma||'';
  document.getElementById('f-signo').value=ev.signo||'';
  document.getElementById('f-slua').value=ev.slua||'';
  document.getElementById('f-asc').value=ev.asc||'';
  document.getElementById('f-obs').value=ev.obs||'';

  // Cartão fields
  const isCC=ev.forma==='Cartão de Crédito';
  document.getElementById('cc-fields').style.display=isCC?'block':'none';
  if(isCC){
    document.getElementById('f-bandeira').value=ev.bandeira||'';
    document.getElementById('f-parcelas').value=ev.parcelas||'1';
    document.getElementById('f-portador').value=ev.portador||'';
  }

  // Populate service select then set value
  populateSvc();
  document.getElementById('f-tipo').value=ev.tipo||'';
  document.getElementById('ac-box').style.display='none';
  document.getElementById('modal').classList.add('open');
}

function updateEvent(){
  if(!editingId) return;
  const idx=events.findIndex(e=>e.id===editingId);if(idx===-1) return;
  const nome=document.getElementById('f-nome').value.trim();
  const data=document.getElementById('f-data').value;
  if(!nome||!data) return;

  events[idx]={
    ...events[idx],
    nome, date:data,
    hora:document.getElementById('f-hora').value,
    tipo:document.getElementById('f-tipo').value,
    dur:document.getElementById('f-dur').value,
    valor:document.getElementById('f-valor').value,
    status:document.getElementById('f-status').value,
    forma:document.getElementById('f-forma').value,
    bandeira:document.getElementById('f-bandeira').value,
    parcelas:document.getElementById('f-parcelas').value,
    portador:document.getElementById('f-portador').value,
    signo:document.getElementById('f-signo').value,
    slua:document.getElementById('f-slua').value,
    asc:document.getElementById('f-asc').value,
    obs:document.getElementById('f-obs').value.trim()
  };
  save();
  closeModal();
  selectedDay=data;
  if(calView==='mes') renderCalendar(); else renderWeek();
  renderDayPanel(data);
}

function closeModal(){
  document.getElementById('modal').classList.remove('open');
  // Reset modal back to "new" mode
  editingId=null;
  document.getElementById('modal-title').textContent='✦ Novo Atendimento ✦';
  document.getElementById('modal-save-btn').textContent='✦ Confirmar Atendimento';
  document.getElementById('modal-save-btn').onclick=saveEvent;
}

/* ── CALENDÁRIO EDITORIAL ── */
let edPosts = JSON.parse(localStorage.getItem('mdf4_edposts')||'[]');
let edWeekStart = (()=>{const d=new Date();d.setDate(d.getDate()-d.getDay());return d;})();
let editingEdId = null;
const saveEdPosts = ()=>localStorage.setItem('mdf4_edposts',JSON.stringify(edPosts));

const ED_STATUS_COLORS = {ideia:'#6366f1',producao:'#f59e0b',agendado:'#ec4899',publicado:'#10b981'};
const ED_STATUS_LABELS = {ideia:'💡 Ideia',producao:'🔨 Em produção',agendado:'📅 Agendado',publicado:'✅ Publicado'};
const ED_FORMAT_COLORS = {Feed:'#00d0f0',Story:'#f97316',Reels:'#a855f7',Carrossel:'#10b981'};

function edChangeWeek(d){
  const mode=document.getElementById('ed-mode').value;
  if(mode==='semana'){edWeekStart=new Date(edWeekStart);edWeekStart.setDate(edWeekStart.getDate()+d*7);}
  else{edWeekStart=new Date(edWeekStart);edWeekStart.setMonth(edWeekStart.getMonth()+d);}
  renderEditorial();
}

function renderEditorial(){
  const mode=document.getElementById('ed-mode').value;
  if(mode==='semana') renderEdWeek(); else renderEdMonth();
  renderEdList();
}

function renderEdWeek(){
  const days=[];
  for(let i=0;i<7;i++){const d=new Date(edWeekStart);d.setDate(d.getDate()+i);days.push(d);}
  const s=days[0],e=days[6];
  document.getElementById('ed-title').textContent=`${s.getDate()} ${months[s.getMonth()].slice(0,3)} — ${e.getDate()} ${months[e.getMonth()].slice(0,3)} ${e.getFullYear()}`;
  const todayDS=toDS(new Date());
  let html=`<div class="ed-week-grid">${wdays.map(d=>`<div class="ed-day-hdr">${d}</div>`).join('')}`;
  html+=days.map(d=>{
    const ds=toDS(d),moon=getMoonPhase(ds),moonSign=MOON_SIGNS[ds]||'',moonEmoji=moonSign?SIGN_EMOJI[moonSign]||'':'';
    const dayPosts=edPosts.filter(p=>p.data===ds);
    const isT=ds===todayDS;
    let inner=`<div class="ed-day-num"><span>${d.getDate()}</span><span class="ed-day-moon">${moon.e}</span></div>`;
    if(moonSign) inner+=`<div style="font-size:9px;color:var(--text3);font-style:italic;margin-bottom:3px">${moonEmoji} ☽ ${moonSign}</div>`;
    inner+=dayPosts.map(p=>`<div class="ed-post-chip" style="background:${ED_STATUS_COLORS[p.status]||'#6366f1'}" onclick="openEdModal('${p.id}');event.stopPropagation()" title="${p.titulo}">${p.formato?'['+p.formato+'] ':''} ${p.titulo.slice(0,18)}${p.titulo.length>18?'…':''}</div>`).join('');
    inner+=`<div class="ed-add-hint">+</div>`;
    return `<div class="ed-day-col${isT?' today-ed':''}" onclick="openEdModal(null,'${ds}')">${inner}</div>`;
  }).join('');
  html+='</div>';
  document.getElementById('ed-grid').innerHTML=html;
}

function renderEdMonth(){
  const y=edWeekStart.getFullYear(),m=edWeekStart.getMonth();
  document.getElementById('ed-title').textContent=months[m]+' '+y;
  const first=new Date(y,m,1).getDay(),total=new Date(y,m+1,0).getDate(),prev=new Date(y,m,0).getDate();
  const todayDS=toDS(new Date());
  let html=`<div class="ed-month-grid">${wdays.map(d=>`<div class="ed-day-hdr">${d}</div>`).join('')}`;
  for(let i=0;i<first;i++) html+=`<div class="ed-month-day other-m"><div style="font-size:12px;color:var(--text3)">${prev-first+i+1}</div></div>`;
  for(let d=1;d<=total;d++){
    const ds=`${y}-${String(m+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    const moon=getMoonPhase(ds),isT=ds===todayDS;
    const dayPosts=edPosts.filter(p=>p.data===ds);
    const chips=dayPosts.slice(0,3).map(p=>`<div class="ed-post-chip" style="background:${ED_STATUS_COLORS[p.status]||'#6366f1'};font-size:9px;padding:2px 5px;" onclick="openEdModal('${p.id}');event.stopPropagation()">${p.titulo.slice(0,12)}…</div>`).join('');
    html+=`<div class="ed-month-day${isT?' today-ed':''}" onclick="openEdModal(null,'${ds}')">
      <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:3px"><span style="font-family:'Cinzel',serif;color:var(--text)">${d}</span><span>${moon.e}</span></div>
      ${chips}
    </div>`;
  }
  for(let i=1;i<=42-first-total;i++) html+=`<div class="ed-month-day other-m"><div style="font-size:12px;color:var(--text3)">${i}</div></div>`;
  html+='</div>';
  document.getElementById('ed-grid').innerHTML=html;
}

function renderEdList(){
  const sorted=[...edPosts].sort((a,b)=>a.data.localeCompare(b.data));
  if(!sorted.length){document.getElementById('ed-list').innerHTML=`<div class="no-ev">Nenhum post registrado ainda.</div>`;return;}
  const groups={};
  sorted.forEach(p=>{const[y,m]=p.data.split('-');const k=months[parseInt(m)-1]+' '+y;if(!groups[k]) groups[k]=[];groups[k].push(p);});
  let html='';
  for(const[mo,posts] of Object.entries(groups)){
    html+=`<div style="margin-bottom:24px"><div class="sec-ttl">${mo}</div>`;
    posts.forEach(p=>{
      const fmtColor=ED_FORMAT_COLORS[p.formato]||'var(--c-geral)';
      const stColor=ED_STATUS_COLORS[p.status]||'#6366f1';
      const stLabel=ED_STATUS_LABELS[p.status]||p.status;
      const[,m,d]=p.data.split('-');
      html+=`<div class="ed-post-card" style="border-left-color:${stColor}">
        <div style="min-width:60px;text-align:center">
          <div style="font-family:'Cinzel',serif;font-size:12px;color:var(--gold)">${parseInt(d)} ${months[parseInt(m)-1].slice(0,3)}</div>
          ${p.hora?`<div style="font-size:11px;color:var(--text3)">${p.hora}</div>`:''}
          <div style="font-size:11px;margin-top:4px;padding:2px 6px;border-radius:4px;background:${fmtColor}22;color:${fmtColor};font-family:'Cinzel',serif">${p.formato||'Feed'}</div>
        </div>
        <div class="ed-post-info">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:5px;flex-wrap:wrap;">
            <div class="ed-post-title">${p.titulo}</div>
            <span class="ed-status-badge st-${p.status}">${stLabel}</span>
          </div>
          <div class="ed-post-meta">${p.cat||''}${p.formato?' · '+p.formato:''}</div>
          ${p.copy?`<div class="ed-post-copy">${p.copy.slice(0,120)}${p.copy.length>120?'…':''}</div>`:''}
          ${p.tags?`<div style="font-size:13px;color:var(--c-sibilla);margin-top:5px">${p.tags}</div>`:''}
          ${p.canva?`<a href="${p.canva}" target="_blank" style="font-size:12px;color:var(--c-sibilla);display:block;margin-top:4px">↗ Ver no Canva</a>`:''}
        </div>
        <div style="display:flex;flex-direction:column;gap:5px;">
          <button class="btn-icon" onclick="openEdModal('${p.id}')" title="Editar" style="color:var(--gold2)">✏️</button>
          <button class="btn-icon" onclick="deleteEdPost('${p.id}')" title="Remover">✕</button>
        </div>
      </div>`;
    });
    html+='</div>';
  }
  document.getElementById('ed-list').innerHTML=html;
}

function openEdModal(id, preDate){
  if(id){
    // Edit mode
    const p=edPosts.find(x=>x.id===id);if(!p) return;
    editingEdId=id;
    document.getElementById('ed-modal-title').textContent='✏️ Editar Post';
    document.getElementById('ed-save-btn').textContent='✦ Salvar Alterações';
    document.getElementById('ed-data').value=p.data||'';
    document.getElementById('ed-hora').value=p.hora||'';
    document.getElementById('ed-titulo').value=p.titulo||'';
    document.getElementById('ed-cat').value=p.cat||'Trânsito';
    document.getElementById('ed-formato').value=p.formato||'Feed';
    document.getElementById('ed-status').value=p.status||'ideia';
    document.getElementById('ed-copy').value=p.copy||'';
    document.getElementById('ed-tags').value=p.tags||'';
    document.getElementById('ed-canva').value=p.canva||'';
  } else {
    // New mode
    editingEdId=null;
    document.getElementById('ed-modal-title').textContent='✦ Novo Post ✦';
    document.getElementById('ed-save-btn').textContent='✦ Salvar Post';
    ['ed-titulo','ed-copy','ed-tags','ed-canva','ed-hora'].forEach(i=>document.getElementById(i).value='');
    document.getElementById('ed-data').value=preDate||new Date().toISOString().split('T')[0];
    document.getElementById('ed-cat').value='Trânsito';
    document.getElementById('ed-formato').value='Feed';
    document.getElementById('ed-status').value='ideia';
  }
  document.getElementById('modal-ed').classList.add('open');
}
function closeEdModal(){document.getElementById('modal-ed').classList.remove('open');editingEdId=null;}

function saveEdPost(){
  const titulo=document.getElementById('ed-titulo').value.trim();
  const data=document.getElementById('ed-data').value;
  if(!titulo||!data) return;
  const post={
    id:editingEdId||Date.now().toString(),
    titulo,data,
    hora:document.getElementById('ed-hora').value,
    cat:document.getElementById('ed-cat').value,
    formato:document.getElementById('ed-formato').value,
    status:document.getElementById('ed-status').value,
    copy:document.getElementById('ed-copy').value.trim(),
    tags:document.getElementById('ed-tags').value.trim(),
    canva:document.getElementById('ed-canva').value.trim()
  };
  if(editingEdId){
    const idx=edPosts.findIndex(p=>p.id===editingEdId);
    if(idx>-1) edPosts[idx]=post;
  } else {
    edPosts.push(post);
  }
  saveEdPosts();closeEdModal();renderEditorial();
}
function deleteEdPost(id){edPosts=edPosts.filter(p=>p.id!==id);saveEdPosts();renderEditorial();}

/* ── BACKUP & GOOGLE DRIVE ── */

// ── Collect all data ──
function getAllData(){
  return{
    version:'4.0',
    exportedAt:new Date().toISOString(),
    events, services, blocked, transits, pubs, edPosts,
    meta: localStorage.getItem('mdf4_meta')||'0'
  };
}

// ── Restore all data ──
function restoreData(d){
  if(d.events)   { events=d.events;   save(); }
  if(d.services) { services=d.services; saveSvc(); }
  if(d.blocked)  { blocked=d.blocked;  saveBlk(); }
  if(d.transits) { transits=d.transits; saveTr(); }
  if(d.pubs)     { pubs=d.pubs;       savePubs(); }
  if(d.edPosts)  { edPosts=d.edPosts; saveEdPosts(); }
  if(d.meta)     localStorage.setItem('mdf4_meta', d.meta);
  renderCalendar(); populateSvc();
}

// ── Export JSON ──
function exportJSON(){
  const data=getAllData();
  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  const ts=new Date().toISOString().slice(0,10);
  a.download=`mariana-agenda-${ts}.json`;
  a.click();
  // log to history
  const hist=JSON.parse(localStorage.getItem('mdf4_backupHist')||'[]');
  hist.unshift({ts:new Date().toISOString(),tipo:'Exportação JSON manual',counts:{ev:events.length,cli:[...new Set(events.map(e=>e.nome))].length}});
  if(hist.length>20) hist.pop();
  localStorage.setItem('mdf4_backupHist',JSON.stringify(hist));
  document.getElementById('import-msg').textContent='✦ JSON exportado com sucesso!';
  renderBackup();
}

// ── Import JSON ──
function importJSON(input){
  const file=input.files[0]; if(!file) return;
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const d=JSON.parse(e.target.result);
      restoreData(d);
      const hist=JSON.parse(localStorage.getItem('mdf4_backupHist')||'[]');
      hist.unshift({ts:new Date().toISOString(),tipo:'Importação JSON',counts:{ev:(d.events||[]).length}});
      localStorage.setItem('mdf4_backupHist',JSON.stringify(hist));
      document.getElementById('import-msg').textContent='✦ Dados restaurados com sucesso! '+events.length+' atendimentos carregados.';
      renderBackup();
    }catch(err){
      document.getElementById('import-msg').textContent='⚠ Erro: arquivo inválido ou corrompido.';
    }
  };
  reader.readAsText(file);
  input.value='';
}

// ── Auto-backup on page unload ──
window.addEventListener('beforeunload',()=>{
  try{
    const data=getAllData();
    localStorage.setItem('mdf4_autobackup', JSON.stringify(data));
    localStorage.setItem('mdf4_autobackup_ts', new Date().toISOString());
  }catch(e){}
});

// ── Render backup view ──
function renderBackup(){
  // Status bar
  const gdUser=localStorage.getItem('mdf4_gd_user');
  const lastAuto=localStorage.getItem('mdf4_autobackup_ts');
  const lastGD=localStorage.getItem('mdf4_gd_last_save');
  let statusMsg='Dados salvos localmente no navegador';
  let statusSub=lastAuto?'Último backup automático: '+new Date(lastAuto).toLocaleString('pt-BR'):'Nenhum backup automático ainda';
  let statusIcon='💾';
  if(gdUser&&lastGD){statusMsg='Sincronizado com Google Drive';statusSub='Última sincronização: '+new Date(lastGD).toLocaleString('pt-BR');statusIcon='☁️';}
  document.getElementById('backup-status-icon').textContent=statusIcon;
  document.getElementById('backup-status-msg').textContent=statusMsg;
  document.getElementById('backup-status-sub').textContent=statusSub;

  // Summary
  const clientes=[...new Set(events.map(e=>e.nome))].length;
  document.getElementById('backup-summary').innerHTML=`
    🌙 <b style="color:var(--gold)">${events.length}</b> atendimentos registrados<br>
    👥 <b style="color:var(--gold)">${clientes}</b> clientes cadastradas<br>
    ⭐ <b style="color:var(--gold)">${transits.length}</b> trânsitos<br>
    📝 <b style="color:var(--gold)">${edPosts.length}</b> posts editoriais<br>
    📸 <b style="color:var(--gold)">${pubs.length}</b> publicações`;

  // History
  const hist=JSON.parse(localStorage.getItem('mdf4_backupHist')||'[]');
  const histEl=document.getElementById('backup-history');
  if(!hist.length){histEl.innerHTML='<span style="color:var(--text3);font-style:italic">Nenhum backup realizado ainda.</span>';return;}
  histEl.innerHTML=hist.map(h=>`
    <div style="display:flex;align-items:center;gap:12px;padding:8px 0;border-bottom:1px solid var(--bsoft);">
      <span style="font-size:16px">${h.tipo.includes('Drive')?'☁️':h.tipo.includes('Import')? '⬆':'⬇'}</span>
      <div style="flex:1">
        <div style="font-size:15px;color:var(--text)">${h.tipo}</div>
        <div style="font-size:13px;color:var(--text3)">${new Date(h.ts).toLocaleString('pt-BR')}${h.counts?' · '+h.counts.ev+' atendimentos':''}</div>
      </div>
    </div>`).join('');

  // Google Drive UI
  const gdInfo=JSON.parse(localStorage.getItem('mdf4_gd_info')||'null');
  if(gdInfo&&gdInfo.email){
    document.getElementById('gd-auth-area').style.display='none';
    document.getElementById('gd-connected-area').style.display='block';
    document.getElementById('gd-user-name').textContent=gdInfo.name||'Conta Google';
    document.getElementById('gd-user-email').textContent=gdInfo.email;
  } else {
    document.getElementById('gd-auth-area').style.display='block';
    document.getElementById('gd-connected-area').style.display='none';
  }
}

// ── GOOGLE DRIVE via Google Identity Services + Drive API ──
const GD_CLIENT_ID = 'COLE_SEU_CLIENT_ID_AQUI';
const GD_SCOPES = 'https://www.googleapis.com/auth/drive.file';
const GD_FILE_NAME = 'mariana-agenda.json';
let gdToken = null;
let gdFileId = localStorage.getItem('mdf4_gd_fileId')||null;

function gdSignIn(){
  if(typeof google==='undefined'){
    gdShowMsg('⚠ API do Google não carregada. Verifique sua conexão e adicione seu Client ID.');
    return;
  }
  google.accounts.oauth2.initTokenClient({
    client_id: GD_CLIENT_ID,
    scope: GD_SCOPES,
    callback:(resp)=>{
      if(resp.error){gdShowMsg('⚠ Erro ao conectar: '+resp.error);return;}
      gdToken=resp.access_token;
      // Get user info
      fetch('https://www.googleapis.com/oauth2/v3/userinfo',{headers:{Authorization:'Bearer '+gdToken}})
        .then(r=>r.json()).then(info=>{
          const gdInfo={email:info.email,name:info.name||info.email};
          localStorage.setItem('mdf4_gd_info',JSON.stringify(gdInfo));
          localStorage.setItem('mdf4_gd_token_ts',new Date().toISOString());
          renderBackup();
          gdShowMsg('✦ Conectado como '+gdInfo.email);
        });
    }
  }).requestAccessToken();
}

function gdSignOut(){
  gdToken=null;gdFileId=null;
  localStorage.removeItem('mdf4_gd_info');
  localStorage.removeItem('mdf4_gd_fileId');
  localStorage.removeItem('mdf4_gd_last_save');
  renderBackup();
}

async function gdEnsureToken(){
  if(gdToken) return true;
  // Try silent refresh
  return new Promise(resolve=>{
    if(typeof google==='undefined'){resolve(false);return;}
    try{
      google.accounts.oauth2.initTokenClient({
        client_id:GD_CLIENT_ID,scope:GD_SCOPES,prompt:'',
        callback:(resp)=>{
          if(resp.error){resolve(false);return;}
          gdToken=resp.access_token;resolve(true);
        }
      }).requestAccessToken({prompt:''});
    }catch(e){resolve(false);}
  });
}

async function gdSave(){
  gdShowMsg('Salvando no Drive...');
  const ok=await gdEnsureToken();
  if(!ok){gdShowMsg('⚠ Reconecte sua conta Google para salvar.');return;}
  const content=JSON.stringify(getAllData(),null,2);
  const blob=new Blob([content],{type:'application/json'});
  try{
    if(gdFileId){
      // Update existing file
      await fetch(`https://www.googleapis.com/upload/drive/v3/files/${gdFileId}?uploadType=media`,{
        method:'PATCH',headers:{Authorization:'Bearer '+gdToken,'Content-Type':'application/json'},body:blob
      });
    } else {
      // Search for existing file first
      const search=await fetch(`https://www.googleapis.com/drive/v3/files?q=name='${GD_FILE_NAME}'+and+trashed=false&fields=files(id,name)`,{headers:{Authorization:'Bearer '+gdToken}});
      const sr=await search.json();
      if(sr.files&&sr.files.length>0){
        gdFileId=sr.files[0].id;localStorage.setItem('mdf4_gd_fileId',gdFileId);
        await fetch(`https://www.googleapis.com/upload/drive/v3/files/${gdFileId}?uploadType=media`,{
          method:'PATCH',headers:{Authorization:'Bearer '+gdToken,'Content-Type':'application/json'},body:blob
        });
      } else {
        // Create new file
        const meta=JSON.stringify({name:GD_FILE_NAME,mimeType:'application/json'});
        const form=new FormData();
        form.append('metadata',new Blob([meta],{type:'application/json'}));
        form.append('file',blob);
        const cr=await fetch('https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart',{
          method:'POST',headers:{Authorization:'Bearer '+gdToken},body:form
        });
        const cj=await cr.json();
        gdFileId=cj.id;localStorage.setItem('mdf4_gd_fileId',gdFileId);
      }
    }
    const ts=new Date().toISOString();
    localStorage.setItem('mdf4_gd_last_save',ts);
    const hist=JSON.parse(localStorage.getItem('mdf4_backupHist')||'[]');
    hist.unshift({ts,tipo:'Salvo no Google Drive',counts:{ev:events.length}});
    if(hist.length>20) hist.pop();
    localStorage.setItem('mdf4_backupHist',JSON.stringify(hist));
    gdShowMsg('✦ Salvo no Google Drive em '+new Date(ts).toLocaleString('pt-BR'));
    renderBackup();
  }catch(e){gdShowMsg('⚠ Erro ao salvar: '+e.message);}
}

async function gdLoad(){
  gdShowMsg('Carregando do Drive...');
  const ok=await gdEnsureToken();
  if(!ok){gdShowMsg('⚠ Reconecte sua conta Google para carregar.');return;}
  try{
    let fid=gdFileId;
    if(!fid){
      const search=await fetch(`https://www.googleapis.com/drive/v3/files?q=name='${GD_FILE_NAME}'+and+trashed=false&fields=files(id)`,{headers:{Authorization:'Bearer '+gdToken}});
      const sr=await search.json();
      if(!sr.files||!sr.files.length){gdShowMsg('⚠ Nenhum arquivo encontrado no Drive.');return;}
      fid=sr.files[0].id;gdFileId=fid;localStorage.setItem('mdf4_gd_fileId',fid);
    }
    const res=await fetch(`https://www.googleapis.com/drive/v3/files/${fid}?alt=media`,{headers:{Authorization:'Bearer '+gdToken}});
    const d=await res.json();
    restoreData(d);
    const hist=JSON.parse(localStorage.getItem('mdf4_backupHist')||'[]');
    hist.unshift({ts:new Date().toISOString(),tipo:'Carregado do Google Drive',counts:{ev:(d.events||[]).length}});
    if(hist.length>20) hist.pop();
    localStorage.setItem('mdf4_backupHist',JSON.stringify(hist));
    gdShowMsg('✦ Dados carregados do Drive! '+events.length+' atendimentos restaurados.');
    renderBackup();
  }catch(e){gdShowMsg('⚠ Erro ao carregar: '+e.message);}
}

function gdShowMsg(msg){ const el=document.getElementById('gd-msg');if(el) el.textContent=msg; }

// ── Auto-save to Drive every 10 min if connected ──
setInterval(async ()=>{
  const gdInfo=JSON.parse(localStorage.getItem('mdf4_gd_info')||'null');
  if(gdInfo&&gdInfo.email&&gdToken){
    await gdSave();
  }
}, 10 * 60 * 1000);

// ── Restore auto-backup hint on load ──
(function checkAutoBackup(){
  const lastAuto=localStorage.getItem('mdf4_autobackup_ts');
  if(!lastAuto) return;
  const age=(new Date()-new Date(lastAuto))/1000/60; // minutes
  if(age<5) return; // recent, no need to alert
})();

