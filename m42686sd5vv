  const today=new Date();
  const reativ=all.filter(c=>{
    const last=c.evs.sort((a,b)=>b.date.localeCompare(a.date))[0];
    const diff=(today-new Date(last.date+'T12:00:00'))/86400000;
    return diff>=90;
