function deleteLst(id){events=events.filter(e=>e.id!==id);save();renderLista();}

/* CLIENTES */
function getClientes(){
  const all={};
  events.forEach(ev=>{
    if(!all[ev.nome]) all[ev.nome]={nome:ev.nome,evs:[],signo:ev.signo||'',total:0,pago:0};
    all[ev.nome].evs.push(ev);all[ev.nome].total+=parseFloat(ev.valor||0);
    if(ev.status==='pago') all[ev.nome].pago+=parseFloat(ev.valor||0);
    if(ev.signo&&!all[ev.nome].signo) all[ev.nome].signo=ev.signo;
  });
  return Object.values(all).sort((a,b)=>b.evs.length-a.evs.length);
}
