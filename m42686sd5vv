function getMoonPhase(ds){
  if(MOON_PHASES[ds]) return MOON_PHASES[ds];
  const d=new Date(ds+"T12:00:00"),k=new Date('2000-01-06');
  const ph=(((d-k)/86400000)%29.53059+29.53059)%29.53059;
  if(ph<3.7) return{f:"nova",e:"🌑",l:""};
  if(ph<11.1) return{f:"crescente",e:"🌒",l:""};
  if(ph<18.5) return{f:"cheia",e:"🌕",l:""};
  return{f:"minguante",e:"🌖",l:""};
}
