function renderWeek(){
  const days=[];
  for(let i=0;i<7;i++){const d=new Date(weekStart);d.setDate(d.getDate()+i);days.push(d);}
  const s=days[0],e=days[6];
  document.getElementById('week-title').textContent=`${s.getDate()} ${months[s.getMonth()].slice(0,3)} — ${e.getDate()} ${months[e.getMonth()].slice(0,3)} ${e.getFullYear()}`;
  const todayDS=toDS(new Date());
  let html=`<div class="wg-corner"></div>`;
  days.forEach(d=>{
    const ds=toDS(d),moon=getMoonPhase(ds),moonSign=MOON_SIGNS[ds]||'',moonEmoji=moonSign?SIGN_EMOJI[moonSign]||'':'';
    const isT=ds===todayDS,isSel=selectedDay===ds;
    html+=`<div class="wg-day-hdr${isT?' today-col':''}${isSel?' sel-col':''}" onclick="selectDay('${ds}')">
      <div class="wg-day-name">${wdays[d.getDay()]}</div>
      <div class="wg-day-num">${d.getDate()}</div>
      <div class="wg-day-moon">${moon.e}</div>
      ${moonSign?`<div class="wg-day-sign">${moonEmoji} ${moonSign}</div>`:''}
    </div>`;
  });
  HOURS.forEach(h=>{
    html+=`<div class="wg-time-cell">${h}</div>`;
    days.forEach(d=>{
      const ds=toDS(d),isT=ds===todayDS,isB=blocked.includes(ds),isSel=selectedDay===ds;
      const hasTr=transits.some(t=>t.dateIni<=ds&&(!t.dateFim||t.dateFim>=ds));
      let cls='wg-slot';
      if(isT) cls+=' today-col';if(isB) cls+=' blocked-col';if(isSel) cls+=' sel-col';if(hasTr) cls+=' tr-active';
      const slotEvs=events.filter(ev=>ev.date===ds&&ev.hora&&ev.hora.slice(0,5)===h);
      let evHtml='';
      slotEvs.forEach(ev=>{
        const dur=parseInt(ev.dur||60),slots=Math.max(1,Math.round(dur/30)),ht=slots*54;
        evHtml+=`<div class="wg-ev" style="background:${svcColor(ev.tipo)};height:${ht}px;">
          <div class="wg-ev-time">${ev.hora}</div>
          <div class="wg-ev-name">${ev.nome.split(' ')[0]}</div>
          <div class="wg-ev-tipo">${ev.tipo||'Consulta'}</div>
        </div>`;
      });
      const clickHandler=slotEvs.length?`selectDay('${ds}')`:`openModal('${ds}','${h}')`;
      html+=`<div class="${cls}" onclick="${clickHandler};event.stopPropagation()">
        ${evHtml}
        ${!slotEvs.length?`<div class="wg-add-hint">+</div>`:''}
      </div>`;
    });
  });
  document.getElementById('week-grid').innerHTML=html;
  if(selectedDay) renderDayPanel(selectedDay);
}

/* SELECT DAY */
function selectDay(ds){
  selectedDay=ds;
  if(calView==='mes') renderCalendar(); else renderWeek();
  renderDayPanel(ds);
  document.getElementById('add-btn').style.display='flex';
  const b=document.getElementById('block-btn');b.style.display='inline-flex';
  const isB=blocked.includes(ds);
  b.textContent=isB?'✓ Desbloquear':'⊘ Bloquear';
  b.className='sm-btn '+(isB?'safe':'danger');
}
function toggleBlock(){
  if(!selectedDay) return;
  const i=blocked.indexOf(selectedDay);if(i>-1) blocked.splice(i,1); else blocked.push(selectedDay);
  saveBlk();selectDay(selectedDay);
}

/* DAY PANEL */
function renderDayPanel(ds){
  const moon=getMoonPhase(ds),mp=MOON_PHASES[ds];
  const moonSign=MOON_SIGNS[ds]||'',moonEmoji=moonSign?SIGN_EMOJI[moonSign]||'':'';
  const moonTxt=mp?` — ${moon.e} ${moon.l}`:` ${moon.e}`;
  const signTxt=moonSign?` · ${moonEmoji} ☽ ${moonSign}`:'';
  document.getElementById('dp-title').textContent=fmtDate(ds)+moonTxt+signTxt;
  const isB=blocked.includes(ds);
  const b=document.getElementById('block-btn');
  b.textContent=isB?'✓ Desbloquear':'⊘ Bloquear';b.className='sm-btn '+(isB?'safe':'danger');
  // transits
  const dayTr=transits.filter(t=>t.dateIni<=ds&&(!t.dateFim||t.dateFim>=ds));
  const trEl=document.getElementById('day-transit-panel');
  if(dayTr.length){
    let h=`<div class="transit-panel-day"><div class="tp-ttl">TRÂNSITOS ATIVOS</div>`;
    dayTr.forEach(t=>{
      const aspSym=t.aspecto?` <span style="color:${t.cor||'var(--gold)'};">${t.aspecto}</span>`:'';
      h+=`<div class="tp-item"><span class="tp-planet">${t.planeta}</span>
        <div><b style="color:${t.cor||'var(--gold)'}">${t.titulo}</b>${aspSym}${t.desc?'<br><span style="font-size:15px;color:var(--text3)">'+t.desc+'</span>':''}</div></div>`;
    });
    h+='</div>';trEl.innerHTML=h;
  } else trEl.innerHTML='';
  // events
  const dayEvs=events.filter(e=>e.date===ds).sort((a,z)=>a.hora.localeCompare(z.hora));
  let html='';
  if(isB) html+=`<div class="ev-item" style="border-left-color:var(--c-blocked)"><div class="ev-info"><div class="ev-name" style="color:var(--text3)">⊘ Dia bloqueado</div><div class="ev-sub">Indisponível para atendimentos</div></div></div>`;
  if(!dayEvs.length&&!isB) html+=`<p style="color:var(--text3);font-style:italic;font-size:19px;padding:10px 0">Nenhum atendimento neste dia.</p>`;
  dayEvs.forEach(ev=>{
    const color=svcColor(ev.tipo);
    const[,m,d]=ds.split('-');
    const wb=encodeURIComponent(`Olá ${ev.nome}! Confirmo seu atendimento de ${ev.tipo||'consulta'} no dia ${parseInt(d)}/${parseInt(m)} às ${ev.hora||'horário combinado'}. Até lá! 🌙`);
    let pagInfo=ev.forma||'';
    if(ev.forma==='Cartão de Crédito'){
      if(ev.bandeira) pagInfo+=` ${ev.bandeira}`;
      if(ev.parcelas&&ev.parcelas!=='1') pagInfo+=` ${ev.parcelas}×`;
      if(ev.portador) pagInfo+=` (${ev.portador})`;
    }
    html+=`<div class="ev-item" style="border-left-color:${color}">
      <div class="ev-time">${ev.hora||'—'}</div>
      <div class="ev-info">
        <div class="ev-name">${ev.nome}</div>
        <div class="ev-sub">${ev.tipo||'Consulta'}${ev.signo?' · '+ev.signo:''}${ev.slua?' · ☽ '+ev.slua:''}${ev.asc?' · ASC '+ev.asc:''}</div>
        ${ev.valor?`<div class="ev-valor">${fmtR(ev.valor)}<span class="badge ${badgeC(ev.status)}">${badgeL(ev.status)}</span>${pagInfo?`<span style="font-size:14px;color:var(--text3)">${pagInfo}</span>`:''}</div>`:''}
        ${ev.obs?`<div class="ev-obs">${ev.obs}</div>`:''}
      </div>
      <div class="ev-acts">
        <button class="btn-icon" onclick="window.open('https://wa.me/?text=${wb}','_blank')" title="WhatsApp">📱</button>
        <button class="btn-icon" onclick="gerarPDF('${ev.id}')" title="Comprovante PDF">📄</button>
        <button class="btn-icon" onclick="openEditModal('${ev.id}')" title="Editar atendimento" style="color:var(--gold2)">✏️</button>
        <button class="btn-icon" onclick="deleteEv('${ev.id}')" title="Remover">✕</button>
      </div>
    </div>`;
  });
  document.getElementById('ev-list').innerHTML=html;
}

